# Copier ce fichier en .env.local et renseigner les valeurs.
# Projet Supabase : Project Settings → API (URL, clé anon, clé service_role).

# Exposées au navigateur (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://<ref-du-projet>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Adresse publique du site, utilisée dans les QR codes et les liens des e-mails.
# Local : http://localhost:3000 — Production : https://<projet>.vercel.app
# Pour scanner depuis un téléphone en local, mettre l'IP du poste
# (ex. http://192.168.1.20:3000) ou utiliser l'adresse Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Serveur uniquement — ne JAMAIS préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# E-mails. Sans RESEND_API_KEY, les e-mails sont affichés dans la console du
# serveur au lieu d'être envoyés (recommandé pour la démo).
RESEND_API_KEY=
# Expéditeur sur un domaine vérifié dans Resend. Par défaut
# onboarding@resend.dev, qui ne peut écrire qu'à l'adresse du compte Resend.
EMAIL_EXPEDITEUR=

# Démo publique (voir README, « Démo publique »). À true, l'accueil et
# /connexion proposent « Entrer comme juridiction » / « Entrer comme médiateur »
# sans mot de passe, et un bandeau prévient que les données sont fictives.
# Fixée au build : redéployer après modification. Vide ou false : désactivée.
NEXT_PUBLIC_DEMO_MODE=false

# Serveur uniquement : comptes de démonstration utilisés par ces boutons
# (rôle « greffe » pour la juridiction, « mediateur » pour le médiateur).
DEMO_JURIDICTION_EMAIL=greffe@exemple.fr
DEMO_JURIDICTION_PASSWORD=
DEMO_MEDIATEUR_EMAIL=mediateur@exemple.fr
DEMO_MEDIATEUR_PASSWORD=

# Serveur uniquement : secret de la remise à zéro nocturne (/api/reset-demo,
# appelée par Vercel Cron avec « Authorization: Bearer <CRON_SECRET> »).
# Générer avec : openssl rand -hex 32
CRON_SECRET=
