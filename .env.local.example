# Copier ce fichier en .env.local et renseigner les valeurs.
# En local, `npx supabase status` affiche l'URL et les clés.

# Exposées au navigateur (préfixe NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — ne JAMAIS préfixer par NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
